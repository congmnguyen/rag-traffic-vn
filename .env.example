# Paths are optional; these are the built-in defaults.
RAG_SOURCE_DIR=data/raw/Thongtu
RAG_INDEX_DIR=data/index
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_TOP_K=6
RAG_MIN_SCORE=0.55

# Optional. The pipeline auto-detects this user-local fallback when a system
# Tesseract installation is unavailable.
RAG_TESSERACT_ROOT=/home/cong/.local/opt/tesseract

# Both values are required to enable answer generation. Without them the API
# remains usable in evidence-only mode.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
